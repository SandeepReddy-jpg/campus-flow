#send the request to create the user
POST  http://localhost:4000/user-api/register
Content-Type: application/json

{
  "role":"hod",
  "username":"Aditya",
  "email":"hod@gmail.com",
  "id":"hod-101",
  "password":"123456",
  "phno":123456
}

###
#login request
POST http://localhost:4000/user-api/login
Content-Type: application/json

{
  "email":"test@gmail.com",
  "password":"123456"
}


